# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Postgres connection
DATABASE_URL=postgresql+psycopg2://nikilos_user:changeme@localhost:5432/nikilos_dev

# JWT auth
SECRET_KEY=changeme-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (fill in once you create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# App
ENVIRONMENT=development
